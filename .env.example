# Pe server: copiază în /etc/skutio-api/env (sudo chmod 600). NU comite cheia reală.
ANTHROPIC_API_KEY=sk-ant-...

# Secret partajat anti-abuz. Aceeași valoare ca SKUTIO_APP_SECRET din aplicația mobilă.
# Când e setat, orice request fără header-ul corect `x-skutio-key` primește 401.
# Generează: openssl rand -base64 32
SKUTIO_APP_SECRET=

# Opțional
# AI_MODEL=claude-sonnet-4-6
# PORT=3000
# PROMPTS_DIR=/etc/skutio-api/prompts   # prompturile de producție (în afara repo-ului)
