    {
      "parameters": {
        "jsCode": "// Titlul și textul articolului din HTML (fără scripturi, stiluri și tag-uri), max 8000 caractere.\nconst html = String($json.data ?? '');\nconst url = $('Validează URL-ul').first().json.url;\nconst decode = (s) => s.replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&quot;/g, '\"').replace(/&#39;/g, \"'\").replace(/&lt;/g, '<').replace(/&gt;/g, '>');\nconst title = decode((html.match(/<title[^>]*>([\\s\\S]*?)<\\/title>/i)?.[1] ?? '').trim());\nconst body = html.match(/<article[\\s\\S]*?<\\/article>/i)?.[0] ?? html;\nconst text = decode(body\n  .replace(/<(script|style|nav|header|footer|aside|noscript)[\\s\\S]*?<\\/\\1>/gi, ' ')\n  .replace(/<[^>]+>/g, ' '))\n  .replace(/\\s+/g, ' ').trim().slice(0, 8000);\nreturn [{ json: { url, title, text, chars: text.length } }];"
      },
      "id": "c2f0a8e2-1c1e-4a51-9a10-0d6a1c000005",
      "name": "Extrage textul",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-6', max_tokens: 800, system: \"E\\u0219ti copywriter B2B pentru LinkedIn. Pe baza articolului primit, scrie o postare LinkedIn \\u00een limba rom\\u00e2n\\u0103: o prim\\u0103 fraz\\u0103 care atrage aten\\u021bia, 3-4 idei cheie scurte (pe r\\u00e2nduri separate), o concluzie cu un \\u00eendemn la discu\\u021bie \\u0219i 3-5 hashtag-uri relevante la final. Maximum 1300 de caractere. Ton profesionist, f\\u0103r\\u0103 emoji excesive. Nu inventa cifre, nume sau citate care nu apar \\u00een articol. Returneaz\\u0103 doar textul post\\u0103rii.\", messages: [{ role: 'user', content: 'Titlu: ' + $json.title + '\\nURL: ' + $json.url + '\\n\\nArticol:\\n' + $json.text }] }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "c2f0a8e2-1c1e-4a51-9a10-0d6a1c000006",
      "name": "Claude: scrie postarea",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
