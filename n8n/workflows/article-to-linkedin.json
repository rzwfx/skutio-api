      ]
    },
    {
      "parameters": {
        "jsCode": "const post = $json.content?.[0]?.text?.trim() ?? '';\nconst src = $('Extrage textul').first().json;\nreturn [{ json: { ok: post.length > 0, source: { url: src.url, title: src.title }, post, chars: post.length, model: $json.model } }];"
      },
