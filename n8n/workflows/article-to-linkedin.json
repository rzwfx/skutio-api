    {
      "parameters": {
        "jsCode": "// Acceptă doar URL-uri http(s) publice. Blochează adresele interne (protecție SSRF):\n// altfel cineva ar putea folosi fluxul ca să citească servicii din rețeaua serverului.\n// Limită cunoscută: verificăm numele, nu IP-ul rezolvat prin DNS.\nconst raw = String($json.body?.url ?? '').trim();\nlet u;\ntry { u = new URL(raw); } catch { return [{ json: { valid: false, error: 'invalid_url' } }]; }\nconst h = u.hostname.toLowerCase().replace(/^\\[|\\]$/g, '');\nconst internal =\n  h === 'localhost' || h.endsWith('.localhost') || h.endsWith('.local') || h.endsWith('.internal') ||\n  !h.includes('.') && !h.includes(':') ||\n  /^(0|10|127)\\./.test(h) || /^169\\.254\\./.test(h) || /^192\\.168\\./.test(h) || /^172\\.(1[6-9]|2\\d|3[01])\\./.test(h) ||\n  h === '::1' || /^f[cd]/.test(h) || /^fe80:/.test(h);\nif (!/^https?:$/.test(u.protocol) || internal) return [{ json: { valid: false, error: 'url_not_allowed' } }];\nreturn [{ json: { valid: true, url: u.toString() } }];"
      },
      "id": "c2f0a8e2-1c1e-4a51-9a10-0d6a1c000002",
      "name": "Validează URL-ul",
