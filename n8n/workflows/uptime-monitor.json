{
  "id": "skutioUptime0001",
  "name": "Skutio — monitorizare uptime (alertă Telegram)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "b1f0a8e2-1c1e-4a51-9a10-0d6a1c000001",
      "name": "La fiecare 5 minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://api.skutio.app/health",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "b1f0a8e2-1c1e-4a51-9a10-0d6a1c000002",
      "name": "GET /health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Alertă doar la SCHIMBAREA stării (a căzut / și-a revenit), nu la fiecare verificare.\n// Starea anterioară se ține în datele statice ale workflow-ului (persistă între execuții).\nconst state = $getWorkflowStaticData('global');\nconst r = $input.first().json;\nconst up = r.statusCode === 200 && r.body && r.body.ok === true;\nconst prev = state.up ?? true;\nstate.up = up;\nif (up === prev) return [];\n\nconst cause = r.statusCode ? `HTTP ${r.statusCode}` : (r.error?.message || 'fără răspuns');\nconst text = up\n  ? '✅ api.skutio.app și-a revenit și răspunde normal.'\n  : `🔴 api.skutio.app NU răspunde (${cause}).\\nVerifică: ssh skutio → sudo systemctl status skutio-api`;\nreturn [{ json: { up, text, checkedAt: new Date().toISOString() } }];"
      },
      "id": "b1f0a8e2-1c1e-4a51-9a10-0d6a1c000003",
      "name": "S-a schimbat starea?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "PUNE_AICI_CHAT_ID",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "b1f0a8e2-1c1e-4a51-9a10-0d6a1c000004",
      "name": "Alertă Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        0
      ]
    }
  ],
  "connections": {
    "La fiecare 5 minute": {
      "main": [
        [
          {
            "node": "GET /health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET /health": {
      "main": [
        [
          {
            "node": "S-a schimbat starea?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "S-a schimbat starea?": {
      "main": [
        [
          {
            "node": "Alertă Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Bucharest"
  },
  "active": false,
  "pinData": {}
}
